    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "subProcess": true,
            "justMyCode": false
        },
        {
            "name": "Run Niclas",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "program": "run/main.py",
            "args": [
                "-o",
                "data",
                "-f",
                "run/nicla_standalone/niclas.yml",
                "-e",
                "project=Niclas",
                "type=Test",
                "trial=0",
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "console": "integratedTerminal",
            "subProcess": true,
            "justMyCode": false
        },
