    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Prosthesis w/ CLI",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "program": "run/main.py",
            "args": [
                "-o", "data",
                "-f", "run/prosthesis_standalone_cli/prosthesis.yml",
                "-e", "project=AidwearStandaloneCli", "type=Test", "trial=0",
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "console": "integratedTerminal",
            "subProcess": true,
            "justMyCode": false
        },
        {
            "name": "Run Prosthesis w/ GUI",
            "type": "debugpy",
            "request": "launch",
